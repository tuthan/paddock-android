<?xml version="1.0" encoding="utf-8"?>
<!-- The 4 x 1 strip: one line, and the time of the read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="4dp">
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/line_needs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:maxLines="1"
            android:text="@string/widget_unread"
            android:textSize="15sp"
            android:textColor="@color/widget_needs_you"
            android:visibility="gone" />
        <TextView
            android:id="@+id/line_quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:maxLines="1"
            android:text="@string/widget_unread"
            android:textSize="15sp"
            android:textColor="@color/widget_title" />
        <TextView
            android:id="@+id/line_old"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:maxLines="1"
            android:text="@string/widget_unread"
            android:textSize="15sp"
            android:textColor="@color/widget_dim"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/asof"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/ibm_plex_sans_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
