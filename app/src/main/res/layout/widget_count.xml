<?xml version="1.0" encoding="utf-8"?>
<!-- The 2 x 2 count: how many agents need the user, and the time of the read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">
    <FrameLayout
        android:id="@+id/count_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/count_needs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textSize="34sp"
            android:textColor="@color/widget_needs_you"
            android:visibility="gone" />
        <TextView
            android:id="@+id/count_quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textSize="34sp"
            android:textColor="@color/widget_title"
            android:visibility="gone" />
        <TextView
            android:id="@+id/count_old"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textSize="34sp"
            android:textColor="@color/widget_dim"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_sans_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:text="@string/widget_unread"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/asof"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_sans_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
