<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext off, system CAs only. The app speaks SSH, not HTTP; this guards any library that tries. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
