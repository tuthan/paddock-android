<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A normal permission: lets ConnectionOwner notice a default-network change and replace a dead socket. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13 and later: asked for in context, when the user turns alerts on in Settings (Phase 07). A refusal has a recovery row. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 17 (target 37) gates LAN sockets behind this grant. Phase 02 requests and recovers it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Phase 14 (decision D2): the in-app scanner reads the code a desktop shows. Asked for only when the scanner is opened, never at launch;
         the scanner is optional (paste a pairing link, or the system camera app, do the same), so no camera is not a reason to hide the app from a store.
         CAMERA implies the camera feature and autofocus both, so both are declared optional: a store filters on what is required, and a fixed-focus
         camera still reads a code held at a distance. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Connector mode (Phase 07): which apps on this phone are UnifiedPush distributors, so the user can pick one. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:name=".PaddockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Paddock"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An alert's link (ntfy's tap, or a notification Paddock raised). Any app can fire it, so DeepLink.parse is the boundary.
                 No BROWSABLE category: a web page cannot open it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="paddock" android:host="open" />
            </intent-filter>
            <!-- A pairing link from the machine (its tap in a message, or a share). It only fills in Add machine: PairingLinks.parse is the
                 boundary, nothing connects and the host key is still the user's to trust. No BROWSABLE category, so a web page cannot open it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="paddock" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- The UnifiedPush messaging receiver. Exported because a distributor is another app; the token each registration carries is
             the only authentication the specification has, and UnifiedPushConnector drops anything that does not hold one. -->
        <receiver android:name=".notify.UnifiedPushReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (Phase 10). They draw only what the cache file holds and hold no connection; the provider ignores the ids and
             extras of any intent and asks the system for its own. The category is home screen only, so none can be put on the lock screen. -->
        <receiver android:name=".widget.SummaryWidgetProvider" android:exported="true" android:label="@string/widget_summary_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_summary_info" />
        </receiver>
        <receiver android:name=".widget.CountWidgetProvider" android:exported="true" android:label="@string/widget_count_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_count_info" />
        </receiver>
        <receiver android:name=".widget.StripWidgetProvider" android:exported="true" android:label="@string/widget_strip_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_strip_info" />
        </receiver>

        <!-- The widgets' cache refresh. Only the system's job scheduler may bind it. -->
        <service android:name=".widget.WidgetRefreshJobService" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
